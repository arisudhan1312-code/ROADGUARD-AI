# Copy this file to backend/.env and replace the placeholders locally.
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_your_local_mysql_password
MYSQL_DATABASE=roadguard_ai
MYSQL_POOL_SIZE=5
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
# Set COOKIE_SECURE=true when the deployed site is served over HTTPS.
COOKIE_SECURE=false
FLASK_DEBUG=false
REPORT_UPLOAD_FOLDER=uploads/reports
EVIDENCE_UPLOAD_FOLDER=uploads/repair-evidence
AI_DETECTION_UPLOAD_FOLDER=detection_uploads
ROADGUARD_YOLO_MODEL=models/road_damage.pt
AI_DETECTION_CONFIDENCE=0.10
AI_DETECTION_REVIEW_THRESHOLD=0.35
