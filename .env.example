# Copy this to backend/.env and fill in your real values.
# NEVER commit backend/.env to Git.

SECRET_KEY=replace_with_random_32_char_string
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=roadguard_ai
MYSQL_POOL_SIZE=5
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
COOKIE_SECURE=false
FLASK_DEBUG=false
REPORT_UPLOAD_FOLDER=uploads/reports
EVIDENCE_UPLOAD_FOLDER=uploads/repair-evidence
AI_DETECTION_UPLOAD_FOLDER=detection_uploads
ROADGUARD_YOLO_MODEL=models/road_damage.pt
AI_DETECTION_CONFIDENCE=0.10
AI_DETECTION_REVIEW_THRESHOLD=0.35
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_CLAIM_EMAIL=your_email@example.com
